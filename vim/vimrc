" Personal Vim configuration. Loaded automatically by Vim's XDG support.
set nocompatible

let g:markdown_fenced_languages = ['python', 'py=python', 'c', 'cpp', 'c++=cpp']
let g:c_functions = 1
let g:c_function_pointers = 1
filetype plugin indent on
syntax enable

" Use the terminal's palette, including Kitty's custom colors.
set notermguicolors
set background=dark
colorscheme onyr

set mouse=a

" Connect the clipboard registers to the existing Wayland clipboard tools.
if has('clipboard_provider') && !empty($WAYLAND_DISPLAY)
  function! s:ClipboardAvailable() abort
    return executable('wl-copy') && executable('wl-paste')
  endfunction

  function! s:ClipboardCopy(reg, type, lines) abort
    let l:command = 'wl-copy --type text/plain;charset=utf-8'
    if a:reg ==# '*'
      let l:command .= ' --primary'
    endif
    let l:text = join(a:lines, "\n")
    if a:type ==# 'V'
      let l:text .= "\n"
    endif
    call system(l:command, l:text)
  endfunction

  function! s:ClipboardPaste(reg) abort
    let l:command = 'wl-paste --no-newline --type text'
    if a:reg ==# '*'
      let l:command .= ' --primary'
    endif
    let l:text = system(l:command)
    if v:shell_error
      return []
    endif
    let l:linewise = l:text =~# "\n$"
    let l:lines = split(l:text, "\n", 1)
    if l:linewise
      call remove(l:lines, -1)
    endif
    return [l:linewise ? 'V' : 'v', l:lines]
  endfunction

  let v:clipproviders['wl_clipboard'] = {
        \ 'available': function('s:ClipboardAvailable'),
        \ 'copy': {'+': function('s:ClipboardCopy'), '*': function('s:ClipboardCopy')},
        \ 'paste': {'+': function('s:ClipboardPaste'), '*': function('s:ClipboardPaste')}
        \ }
  set clipmethod^=wl_clipboard
  set clipboard=unnamedplus
endif

set number
set cursorline
set laststatus=2
set scrolloff=5
set splitbelow splitright
set hidden
set backspace=indent,eol,start
set wildmenu
set wildmode=longest:full,full

set incsearch hlsearch
set ignorecase smartcase
nnoremap <silent> <Esc> <Cmd>nohlsearch<CR>

" Filetype plugins can override these defaults for individual buffers.
set expandtab
set tabstop=4 shiftwidth=4 softtabstop=4
set autoindent
set nowrap
set textwidth=0

augroup onyr_prose
  autocmd!
  " Soft wrapping affects display only. Never insert hard line breaks.
  autocmd FileType markdown setlocal wrap linebreak textwidth=0 wrapmargin=0 formatoptions-=t formatoptions-=c formatoptions-=a
augroup END

" Keep persistent undo and editor state out of source directories.
let s:state = empty($XDG_STATE_HOME) ? expand('~/.local/state') : $XDG_STATE_HOME
let s:state .= '/vim'
for s:directory in [s:state, s:state . '/undo', s:state . '/swap', s:state . '/backup']
  call mkdir(s:directory, 'p', 0700)
endfor
let &undodir = s:state . '/undo//'
let &directory = s:state . '/swap//'
let &backupdir = s:state . '/backup//'
let &viminfofile = s:state . '/viminfo'
set undofile
unlet s:state s:directory
